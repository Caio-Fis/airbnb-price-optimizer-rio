# GCP
GCP_PROJECT_ID=your-project-id
GCP_BUCKET_NAME=airbnb-price-optimizer
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=airbnb-price-optimizer
MLFLOW_ARTIFACT_ROOT=gs://airbnb-price-optimizer/mlflow-artifacts

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# PostgreSQL (shared by Airflow and MLflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# API
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=/app/models/model.joblib
ENCODERS_PATH=/app/models/encoders.joblib

# Data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
IMAGES_PATH=data/images
INSIDE_AIRBNB_CITY=rio-de-janeiro
